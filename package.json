{
  "name": "portal-local",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "test": "node --test scripts/check-architecture.test.mjs && pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @portal/web build && playwright test",
    "test:e2e:access": "playwright test -c playwright.access.config.ts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "env:local": "node infra/scripts/new-local-env.mjs",
    "env:example": "node infra/scripts/write-example.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
