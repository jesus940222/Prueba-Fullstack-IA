{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portal.local/schemas/events/audit-event-1.schema.json",
  "title": "Documento de auditoría v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "received_at",
    "source_service",
    "actor_type",
    "actor_id",
    "resource_type",
    "resource_id",
    "action",
    "outcome",
    "channel",
    "correlation_id"
  ],
  "properties": {
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "schema_version": {"const": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "received_at": {"type": "string", "format": "date-time"},
    "source_service": {"type": "string", "minLength": 1, "maxLength": 40},
    "actor_type": {"enum": ["user", "service", "system"]},
    "actor_id": {"type": "string", "format": "uuid"},
    "customer_id": {"type": ["string", "null"], "format": "uuid"},
    "resource_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "resource_id": {"type": "string", "minLength": 1, "maxLength": 80},
    "action": {"type": "string", "minLength": 1, "maxLength": 80},
    "outcome": {"enum": ["success", "failure", "denied"]},
    "reason_code": {"type": ["string", "null"], "maxLength": 80},
    "channel": {"enum": ["web", "service", "system"]},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["field", "redacted"], "properties": {"field": {"type": "string"}, "redacted": {"const": true}}}},
    "metadata": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}}
  }
}
